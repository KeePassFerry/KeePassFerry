<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests für Plugin und Host ohne KeePass-Oberfläche und ohne echte Datenbank.
    Voraussetzung: Plugin vorher bauen (msbuild ... -p:Configuration=Release), KeePass.exe in %USERPROFILE%\KeePassDEV
    (wie beim Plugin-Build). Aufruf: dotnet test tests/KeePassFerry.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>KeePassFerry.Tests</AssemblyName>
    <RootNamespace>KeePassFerry.Tests</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <KeePassExe Condition="'$(KeePassExe)' == ''">$(USERPROFILE)\KeePassDEV\KeePass.exe</KeePassExe>
    <PluginBin>..\..\plugin\KeePassFerry\bin\Release\</PluginBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\host\KeePassFerryHost\KeePassFerryHost.csproj" />
    <Reference Include="KeePassFerry">
      <HintPath>$(PluginBin)KeePassFerry.dll</HintPath>
    </Reference>
    <Reference Include="Jayrock">
      <HintPath>$(PluginBin)Jayrock.dll</HintPath>
    </Reference>
    <Reference Include="Jayrock.Json">
      <HintPath>$(PluginBin)Jayrock.Json.dll</HintPath>
    </Reference>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <Target Name="CheckPluginBuilt" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(PluginBin)KeePassFerry.dll')" Text="Plugin nicht gebaut: zuerst msbuild plugin/KeePassFerry/KeePassFerry.csproj -p:Configuration=Release" />
    <Error Condition="!Exists('$(KeePassExe)')" Text="KeePass.exe nicht gefunden ($(KeePassExe)); Pfad mit -p:KeePassExe=... angeben" />
  </Target>

</Project>
